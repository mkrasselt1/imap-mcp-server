BASE_URL=https://your-domain.com
PORT=3000
# 64 hex chars: openssl rand -hex 32  — keep it! If it changes, stored mail passwords are lost.
ENCRYPTION_KEY=
# openssl rand -hex 32
SESSION_SECRET=
# Optional: allow anyone who can reach the server to create an account (default: off)
# ALLOW_SIGNUP=true
# Optional: number of reverse proxies in front (default: 1 if BASE_URL is https, else 0)
# TRUST_PROXY=1
# Optional: comma-separated allowed CORS origins for the API endpoints (default: any, without cookies)
# CORS_ORIGIN=https://claude.ai
